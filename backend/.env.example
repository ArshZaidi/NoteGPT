# ============================================================
# NoteGPT backend — environment template
# Copy to .env and fill in.
# ============================================================

# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings

# ---- Postgres (direct) ----
# Supabase Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---- App ----
ENV=development
# Comma-separated. Include your LAN IP so your phone can hit the API.
CORS_ORIGINS=http://localhost:3000,http://192.168.0.103:3000

# ============================================================
# AI — Groq (primary)
# ============================================================
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Model used for structuring / summarizing notes.
# llama-3.3-70b-versatile is Groq's best general-purpose model.
# Alternatives: llama-3.1-8b-instant (cheap + fast),
#               mixtral-8x7b-32768 (long context).
GROQ_MODEL=llama-3.3-70b-versatile

# Model used for fast tasks (title generation, tag extraction, etc.)
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Whisper model for audio transcription (if you ever add voice notes)
GROQ_WHISPER_MODEL=whisper-large-v3

# ============================================================
# Web research (Chunk 4) — optional
# ============================================================
# Any of these work. Leave blank to skip web research.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=